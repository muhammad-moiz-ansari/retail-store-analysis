# RetailPulse local demo configuration
#
# 1. Copy this file to .env.local for the Next.js app and/or export the same
#    variables before running the FastAPI backend.
# 2. Start the full demo with: npm run dev:all
# 3. Sign in as the seeded manager:
#    manager@retailpulse.local / 123456

# FastAPI unified backend used by frontend/src/app/api/backend/[...path]/route.ts
RETAILPULSE_SERVICE_URL=http://127.0.0.1:8011

# Shared secret required between Next.js API routes and the local FastAPI backend.
# Change both sides together for a non-demo environment.
RETAILPULSE_INTERNAL_SECRET=local-dev-pos-secret
POS_INTERNAL_SECRET=local-dev-pos-secret

# Signed browser session cookie secret for local authentication.
# Use a long random string outside local demos.
POS_AUTH_SECRET=replace-with-a-long-random-local-secret

# SQLite file used by backend/store_core.py for settings, users, alerts, tasks,
# orchestrator events, and staff dispatch.
RETAILPULSE_DB_PATH=backend/retailpulse.sqlite3

# Seeded manager account. These are read only when the database is initialized.
RETAILPULSE_BOOTSTRAP_MANAGER_NAME=Demo Manager
RETAILPULSE_BOOTSTRAP_MANAGER_EMAIL=manager@retailpulse.local
RETAILPULSE_BOOTSTRAP_MANAGER_PASSWORD=password123

# Python executable used by Next.js demo API routes that spawn local CV scripts.
PYTHON_BIN=./.venv/bin/python

# Hugging Face Inference Providers chat completion router used by the
# orchestrator/NLP script agent. Create a token with Inference Providers access.
HF_TOKEN=
HF_ROUTER_URL=https://router.huggingface.co/v1/chat/completions
HF_ORCHESTRATOR_MODEL=meta-llama/Llama-3.1-8B-Instruct:novita
HF_NLP_MODEL=meta-llama/Llama-3.1-8B-Instruct:novita
HF_TIMEOUT_SECONDS=30

# ElevenLabs text-to-speech used by the voice agent. The default voice ID below
# matches the ElevenLabs docs example and can be replaced with any workspace voice.
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TIMEOUT_SECONDS=30

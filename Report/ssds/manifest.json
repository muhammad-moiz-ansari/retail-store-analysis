        [
          "A",
          "crossing configuration and observation coverage support counts"
        ],
        [
          "R",
          "footfallCounts(entries, exits, netChange, coverage)"
        ],
        [
          "O",
          "initial occupancy is known"
        ],
        [
          "R",
          "absoluteOccupancy(initialOccupancy + netChange)"
        ],
        [
          "Z"
        ],
        [
          "E",
          "boundary, role evidence or source coverage is incomplete"
        ],
        [
          "R",
          "partialOrUnavailableCounts(reason, supportedPeriod)"
        ],
        [
          "Z"
        ],
        [
          "N",
          "Unknown initial occupancy permits net change, not an invented whole-store count."
        ]
      ]
    },

  "events": {
    "1": {
      "actor": "Operator / project team",
      "events": [
        [
          "C",
          "analyzeVideo(video, configuration, outputLocation)"
        ],
        [
          "A",
          "input and required models are valid"
        ],
        [
          "R",
          "processingAccepted(runId, samplingConfiguration)"
        ],
        [
          "R",
          "analysisCompleted(runId, coverage, diagnosticOutputLocations)"
        ],
        [
          "E",
          "invalid input, missing model or interrupted processing"
        ],
        [
          "R",
          "analysisFailed(reason, partialOutputStatus)"
        ],
        [
          "Z"
        ],
        [
          "N",
          "A processed sample with no people is a valid empty observation; it is distinct from a failed frame."
        ]
      ]
    },
    "2": {
      "actor": "Manager",
      "events": [
        [
          "C",
          "requestEntranceFootfall(interval, entranceSource)"
